<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ composes the icon from two layers and masks it to the
     launcher's shape: the leaf-and-brackets artwork over the tile's green
     gradient. The monochrome layer is the artwork alone, for Android 13's
     themed icons; earlier versions skip the tag. The PNGs in mipmap-* are
     the legacy icon for Android 7 and below. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>

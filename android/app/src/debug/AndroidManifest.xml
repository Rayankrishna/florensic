<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The local API stack is plain http, so debug builds may use cleartext.
         Release builds must not: this file is debug-only, and the release
         manifest leaves the platform default (cleartext blocked) in place. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic"/>
</manifest>
